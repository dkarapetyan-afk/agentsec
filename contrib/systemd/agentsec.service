[Unit]
Description=agentsec secret management daemon
Documentation=https://github.com/agentsec/agentsec
After=network.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/agentsec daemon
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=info

# Sandboxing & security hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/agentsec
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
